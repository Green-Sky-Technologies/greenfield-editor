# Pinned build inputs for the Greenfield editor build (Story 2.9). Sourced by build.sh, toolchain.sh,
# verify/docker-build.sh and .github/workflows/build.yml. Different wasm-opt or
# wasm-bindgen versions give different bytes, so build.sh refuses any other version.

# Container: rust 1.100.0 on Debian trixie, pinned by the multi-arch index digest.
BUILD_IMAGE=rust:1.100-trixie@sha256:223cc32ddca8f3ee90c436dbc94b6b5f052ea7f9653c5201e9612f08ad7d21b8

# The upstream release this fork is rebased onto (UPSTREAM.md). The build embeds the sha as its
# build id (FIGCRAFT_BUILD_SHA), so bump both together with the rebase.
UPSTREAM_REF=v0.18.1
UPSTREAM_SHA=4acc293c2ec941ac1400837ee7e3ab51780399f8

# Fonts (OFL-1.1), at the ref upstream's release CI uses for v0.18.1.
CRAFT_FONTS_REPO=https://github.com/storytold/craft-fonts
CRAFT_FONTS_SHA=37827adc41fd165f9a9234ac40f94dbad353aa69

TRUNK_VERSION=0.22.2
# Must equal wasm-bindgen in FigCraft's Cargo.lock (trunk runs --offline).
WASM_BINDGEN_VERSION=0.2.129
# binaryen from Debian's permanent snapshot archive (trixie's 120 lacks --enable-bulk-memory-opt).
BINARYEN_VERSION=131
BINARYEN_DEB_URL=https://snapshot.debian.org/archive/debian/20260803T022142Z/pool/main/b/binaryen/binaryen_131-2_ARCH.deb
BINARYEN_DEB_SHA256_amd64=ff5ecf17bd23a949b6358cdde62c03397d10181d6be092bb726413e9e4277081
BINARYEN_DEB_SHA256_arm64=e5ddcf6accc71abdc8d56a47f8ec6e61b95b83118cd2ce90b246f6ceabfd76d7

# Size budget: fail any .wasm over 25 MiB raw (SPEC.md D26).
WASM_MAX_BYTES=26214400
